{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dokina-sk",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/film/*"]
  }
}
